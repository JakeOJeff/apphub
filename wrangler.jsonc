{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apphub",
  "account_id": "e8802cdd4c0651debd5796101609ccc7",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Built UI. /api/* goes to the Worker first; every other path falls back to index.html.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "pyn.garden", "custom_domain": true }],
  "observability": { "enabled": true },
  // Supabase Auth for apphub's own sign-in (the "App Hub" project). Both values are public.
  "vars": {
    "SUPABASE_URL": "https://jiynlnpbjzmndfyfazqo.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_6ohaPDZ_euZjcbG0nOU2yg__AHvzDrD"
  }
  // Secrets (not in this file): ENCRYPTION_KEY
  //   npx wrangler secret put <NAME>
}
